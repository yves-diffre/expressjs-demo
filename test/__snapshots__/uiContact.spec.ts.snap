    <meta name="theme-color" content="#13171f">
  </head>
  <body>
    <header>
      <nav>
        <ul>
          <li>
            <a href="/">
              <strong>Express.js demo</strong>
            </a>
          </li>
        </ul>
        <ul>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/mongo-articles">Mongo articles</a>
          </li>
          <li>
            <a href="/postgres-articles">Postgres articles</a>
          </li>
          <li>
            <a href="/contact" aria-current="page">Contact</a>
          </li>
            <li>
              <a href="/auth/sign-in">Sign in</a>
              <span>/</span>
              <a href="/auth/sign-up">Sign up</a>
            </li>
        </ul>
      </nav>
    </header>
      <main class="PageLayout">
        <header>
          <h1>Contact</h1>
          <div role="group">
          </div>
        </header>
          <div role="alert">
            Please correct the following errors and submit your contact request again.
              <ul>
                  <li>
                    <a id="email-error" href="#email">Please provide a valid email.</a>
                  </li>
                  <li>
                    <a id="name-error" href="#name">Please provide a name with 100 characters maximum.</a>
                  </li>
                  <li>
                    <a id="subject-error" href="#subject">Please provide a subject with 100 characters maximum.</a>
                  </li>
                  <li>
                    <a id="text-error" href="#text">Please provide a text.</a>
                  </li>
              </ul>
          </div>
          <form method="post">
            <fieldset>
              <label for="email">Email</label>
              <input id="email" name="email" placeholder="Your email" required="" type="email" value="" aria-describedby="email-error">
              <label for="name">Name</label>
              <input id="name" maxlength="100" name="name" placeholder="Your name" required="" type="text" value="" aria-describedby="name-error">
              <label for="subject">Subject</label>
              <input id="subject" maxlength="100" name="subject" placeholder="Your subject" required="" type="text" value="" aria-describedby="subject-error">
              <label for="text">Text</label>
              <textarea id="text" name="text" placeholder="Your text" required="" aria-describedby="text-error"></textarea>
            </fieldset>
            <div role="group">
              <button type="submit">Send</button>
            </div>
          </form>
      </main>
  
</body></html>"
`;

