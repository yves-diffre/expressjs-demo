    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#13171f">
  </head>
  <body>
    <header>
      <nav>
        <ul>
          <li>
            <a href="/">
              <strong>Express.js demo</strong>
            </a>
          </li>
        </ul>
        <ul>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/mongo-articles">Mongo articles</a>
          </li>
          <li>
            <a href="/postgres-articles">Postgres articles</a>
          </li>
          <li>
            <a href="/contact" aria-current="page">Contact</a>
          </li>
            <li>
              <a href="/auth/sign-in">Sign in</a>
              <span>/</span>
              <a href="/auth/sign-up">Sign up</a>
            </li>
        </ul>
      </nav>
    </header>
      <main class="PageLayout">
        <header>
          <h1>Contact</h1>
          <div role="group">
          </div>
        </header>
          <form method="post">
            <fieldset>
              <label for="email">Email</label>
              <input id="email" name="email" placeholder="Your email" required="" type="email" value="">
              <label for="name">Name</label>
              <input id="name" maxlength="100" name="name" placeholder="Your name" required="" type="text" value="">
              <label for="subject">Subject</label>
              <input id="subject" maxlength="100" name="subject" placeholder="Your subject" required="" type="text" value="">
              <label for="text">Text</label>
              <textarea id="text" name="text" placeholder="Your text" required=""></textarea>
            </fieldset>
            <div role="group">
              <button type="submit">Send</button>
            </div>
          </form>
      </main>
  
</body></html>"
`;

